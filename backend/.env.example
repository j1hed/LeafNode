# Copy this file to .env and fill in what you have. Everything has a
# safe default / graceful fallback if left blank.

# ---------------------------------------------------------------
# LLM provider - pick one
# ---------------------------------------------------------------
LLM_PROVIDER=lmstudio
# LLM_PROVIDER=groq

# LM Studio (local server, Developer tab -> "Start Server")
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Groq (free tier - create a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1200

# ---------------------------------------------------------------
# External data APIs (optional)
# ---------------------------------------------------------------
WEATHERAPI_KEY=
WEATHERAPI_LOCATION=Tunisia

RAPIDAPI_KEY=

# YouTube Data API v3 key (console.cloud.google.com -> enable
# "YouTube Data API v3" -> Credentials). Optional - if unset, the
# agent only uses whatever is already cached under plant_data/.
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS_PER_PLANT=3
YOUTUBE_TRANSCRIPT_LANGUAGES=en,fr

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
LEAFNODE_DB_FILE=leafnode.db
PLANT_DATA_DIR=plant_data
DISEASE_CACHE_DIR=plant_diseases
LOGS_DIR=logs
DISEASE_CONFIDENCE_THRESHOLD=70

# Comma-separated frontend origins (include your LAN URL when needed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CHATBOT_STALE_SECONDS=300
